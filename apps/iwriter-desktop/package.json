{
  "name": "@gyenbox/iwriter-desktop",
  "version": "0.1.4",
  "private": true,
  "author": "GyenBox",
  "description": "Standalone GyenBox iWriter desktop client.",
  "main": "electron/main.cjs",
  "scripts": {
    "brand:export": "node scripts/export-brand.mjs",
    "native:build": "node scripts/build-menu-icons.mjs && node scripts/build-menu-native.mjs",
    "dev": "npm run native:build && cross-env IWRITER_DESKTOP_URL=http://127.0.0.1:3000/iwriter electron .",
    "start": "electron .",
    "test": "node --test test/*.node-test.cjs",
    "pack:mac": "npm test && npm run native:build && electron-builder --mac dmg --arm64 --x64 --config electron-builder.yml",
    "pack:win": "npm test && electron-builder --win nsis --x64 --arm64 --config electron-builder.yml"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "sanitize-html": "^2.17.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.33.5"
  }
}
