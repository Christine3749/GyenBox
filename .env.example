# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Shared native account service

# Postgres metadata database on Aliyun
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Object storage

# Upload controls
MAX_UPLOAD_BYTES=5368709120

# Local-only API bypass for tests/dev when the account service is absent
ALLOW_UNVERIFIED_ACTOR_HEADER=false

# Public desktop release downloads. Prefer Cloudflare R2 for production.
DESKTOP_WINDOWS_DOWNLOAD_URL=https://pub-0e4094438b384def94b53362d317ac70.r2.dev/desktop/windows/GyenBox-Setup-Windows-latest.exe

HALFSPHERE_API_URL=https://account.gsyen.com
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_BUCKET=gyenbox-files
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
