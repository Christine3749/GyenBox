{
  "name": "gyenbox",
  "version": "0.1.19",
  "private": true,
  "description": "GyenBox privacy-first cloud storage monorepo.",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@gyenbox/web",
    "dev:keep": "turbo dev --filter=@gyenbox/keep",
    "dev:shurufa-ciku": "turbo dev --filter=@gyenbox/shurufa-ciku",
    "dev:shurufa-personal-config": "turbo dev --filter=@gyenbox/shurufa-personal-config",
    "dev:safeauth": "turbo dev --filter=@gyenbox/safeauth",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "npm --workspace @gyenbox/db run generate",
    "db:migrate": "npm --workspace @gyenbox/db run migrate",
    "format": "prettier --write .",
    "desktop:dev": "npm --workspace @gyenbox/desktop run dev",
    "desktop:build": "npm --workspace @gyenbox/desktop run build",
    "iwriter-desktop:dev": "npm --workspace @gyenbox/iwriter-desktop run dev",
    "iwriter-desktop:test": "npm --workspace @gyenbox/iwriter-desktop run test",
    "iwriter-desktop:pack:mac": "npm --workspace @gyenbox/iwriter-desktop run pack:mac",
    "iwriter-desktop:pack:win": "npm --workspace @gyenbox/iwriter-desktop run pack:win"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "turbo": "^2.8.0",
    "typescript": "^5.7.3"
  }
}
